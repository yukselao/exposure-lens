{% import 'partials/icons.twig' as icons %}
<section class="card" id="software">
  <div class="toolbar">
    <div class="search">{{ icons.ic('search', 14) }}<input type="search" class="form-control form-control-sm" id="swSearch" placeholder="Search software" aria-label="Search software"></div>
    <div class="form-check form-switch ms-auto mb-0"><input class="form-check-input" type="checkbox" role="switch" id="swRare"><label class="form-check-label" for="swRare">On fewer than 5 hosts</label></div>
    <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="swRecent"><label class="form-check-label" for="swRecent">Installed in the last 30 days</label></div>
  </div>
  <div class="table-wrap"><table class="table table-hover"><thead id="swHead"></thead><tbody id="swBody"></tbody></table></div>
  <div class="pager" id="swPager"></div>
</section>
