{% import 'partials/icons.twig' as icons %}
<div class="row g-3">
  <div class="col-xl-5">
    <section class="card h-100">
      <div class="card-header">Connection <span class="sub">Tenable Security Center</span></div>
      <div class="card-body">
        <form id="scForm" autocomplete="off" novalidate>
          <div class="mb-3">
            <label class="form-label" for="sc_url">URL</label>
            <input type="url" class="form-control" id="sc_url" name="url" value="{{ sc.url }}" placeholder="https://sc.example.internal">
          </div>
          <div class="mb-3">
            <label class="form-label" for="sc_access_key">Access key</label>
            <input type="password" class="form-control mono" id="sc_access_key" name="access_key" autocomplete="new-password"
                   placeholder="{{ sc.access_key_set ? 'Saved. Leave empty to keep it.' : 'Not set' }}">
          </div>
          <div class="mb-3">
            <label class="form-label" for="sc_secret_key">Secret key</label>
            <input type="password" class="form-control mono" id="sc_secret_key" name="secret_key" autocomplete="new-password"
                   placeholder="{{ sc.secret_key_set ? 'Saved. Leave empty to keep it.' : 'Not set' }}">
            <div class="form-text">Keys are stored encrypted and are never shown again.</div>
          </div>
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="sc_verify" name="verify_ssl" value="1" {{ sc.verify_ssl ? 'checked' }}>
            <label class="form-check-label" for="sc_verify">Verify the TLS certificate</label>
            <div class="form-text">Turn off only for a Security Center with a self-signed certificate.</div>
          </div>
          <div class="d-flex gap-2 align-items-center">
            <button type="submit" class="btn btn-primary" id="scSave">Save</button>
            <button type="button" class="btn btn-outline-primary" id="scTest">Test connection</button>
          </div>
          <div class="status-line mt-3" id="scStatus" role="status"></div>
        </form>
      </div>
    </section>
  </div>
  <div class="col-xl-7">
    <section class="card h-100">
      <div class="card-header">Pools <span class="sub">each pool holds the queries that are synced together</span>
        <span class="ms-auto"><button type="button" class="btn btn-sm btn-primary" id="poolAdd">{{ icons.ic('plus', 14) }} Add pool</button></span></div>
      <div class="card-body" id="poolList"></div>
    </section>
  </div>
</div>
