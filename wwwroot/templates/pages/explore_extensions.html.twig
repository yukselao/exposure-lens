{% import 'partials/icons.twig' as icons %}
<div class="explore" id="extensions">
  <aside class="card"><div class="filter-group"><div class="filter-title">Browser</div><div id="extBrowsers"></div></div></aside>
  <section class="card">
    <div class="toolbar">
      <div class="search">{{ icons.ic('search', 14) }}<input type="search" class="form-control form-control-sm" id="extSearch" placeholder="Search name or extension ID" aria-label="Search extensions"></div>
      <div class="form-check form-switch ms-auto mb-0"><input class="form-check-input" type="checkbox" role="switch" id="extRare"><label class="form-check-label" for="extRare">On fewer than 5 hosts</label></div>
    </div>
    <div class="table-wrap"><table class="table table-hover"><thead id="extHead"></thead><tbody id="extBody"></tbody></table></div>
    <div class="pager" id="extPager"></div>
  </section>
</div>
