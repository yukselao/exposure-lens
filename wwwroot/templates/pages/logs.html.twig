{% import 'partials/icons.twig' as icons %}
<section class="card" id="logs">
  <div class="toolbar">
    <ul class="nav nav-pills" id="logTabs" role="tablist">
      {% for key, label in connectors %}
      <li class="nav-item"><button type="button" class="nav-link py-1 {{ loop.first ? 'active' }}" data-connector="{{ key }}">{{ label }}</button></li>
      {% endfor %}
    </ul>
  </div>
  <div class="toolbar">
    <label class="visually-hidden" for="logLevel">Minimum level</label>
    <select class="form-select form-select-sm" id="logLevel" style="width:auto">
      <option value="debug">All levels</option><option value="info">Info and above</option>
      <option value="warning">Warnings and errors</option><option value="error">Errors only</option>
    </select>
    <div class="search">{{ icons.ic('search', 14) }}<input type="search" class="form-control form-control-sm" id="logSearch" placeholder="Search text, event or job id" aria-label="Search logs"></div>
    <label class="visually-hidden" for="logLines">Entries</label>
    <select class="form-select form-select-sm" id="logLines" style="width:auto">
      <option value="100">Last 100</option><option value="200" selected>Last 200</option><option value="500">Last 500</option><option value="2000">Last 2000</option>
    </select>
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="logAuto"><label class="form-check-label" for="logAuto">Refresh every 5 s</label>
    </div>
    <span class="ms-auto d-flex gap-2 align-items-center">
      <span class="muted" id="logInfo"></span>
      <button type="button" class="btn btn-sm btn-outline-primary" id="logRefresh">{{ icons.ic('refresh', 14) }} Refresh</button>
      <a class="btn btn-sm btn-primary" id="logDownload" href="#">{{ icons.ic('download', 14) }} Download</a>
    </span>
  </div>
  <div class="table-wrap">
    <table class="table log-table">
      <thead><tr><th style="width:170px">Time</th><th style="width:80px">Level</th><th style="width:230px">Event</th><th>Details</th></tr></thead>
      <tbody id="logBody"></tbody>
    </table>
  </div>
</section>
