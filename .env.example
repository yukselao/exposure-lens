tie_host=https://tie.example.internal
tie_apikey=
tie_connector_token_file=./secrets/tie_connector_token
tie_enabled_tools=
tie_cache_refresh_interval_minutes=0

pg_user=exposure_lens
pg_password=
pg_db=exposure_lens

# 64 hex characters; encrypts the SC keys and the TIE token stored in PostgreSQL.
# Create it once with: openssl rand -hex 32 > secrets/app_secret_key
app_secret_key_file=./secrets/app_secret_key

# Seconds between connector job checks.
sc_poll_interval_seconds=30
tie_postgres_poll_interval_seconds=30
sc_log_level=INFO
tie_postgres_log_level=INFO

# Web UI: http://127.0.0.1:<web_port>
web_port=8085
tz=Europe/Istanbul

ctem_poll_interval_seconds=30
ctem_log_level=INFO
